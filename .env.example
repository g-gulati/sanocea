SANOCEA_ENV=local

# Local Postgres cluster provisioned by sanocea/scripts/start_phase05_local.ps1
SANOCEA_PG_DSN=postgresql://sanocea@127.0.0.1:55432/sanocea_phase05

# Local Temporal dev server provisioned by sanocea/scripts/start_phase05_local.ps1
SANOCEA_TEMPORAL_TARGET=127.0.0.1:57233
SANOCEA_RUN_TEMPORAL_TESTS=1

# Local MinIO provisioned by sanocea/scripts/start_phase05_local.ps1
SANOCEA_S3_ENDPOINT=http://127.0.0.1:59000
SANOCEA_S3_ACCESS_KEY=sanocea-dev
SANOCEA_S3_SECRET_KEY=sanocea-dev-secret
SANOCEA_S3_BUCKET=sanocea-phase05

# Optional live external integrations. Leave unset for local Phase 0.5.
# SANOCEA_SHOPIFY_ADMIN_TOKEN=
# SANOCEA_CHATWOOT_API_TOKEN=

# --- Shopify Dev-Store certification (packages/runtime/service_graph.py::_shopify_live_factory,
# connectors/shopify_live/connector.py::ShopifyLiveConnector, connectors/shopify_live/auth.py,
# scripts/run_shopify_dev_store_certification.py) - READ ONLY by the certification harness script,
# which POSTs them into a merchant's own config/credentials via /admin/merchants (the running app never
# reads these env vars directly - every other merchant's Shopify/WooCommerce credentials already live in
# Postgres via store.set_credential_ref(), not env vars; this follows the identical pattern the
# WooCommerce real-platform certification already uses - see SANOCEA_WOOCOMMERCE_* above/in that script).
# ALL VALUES BELOW MUST BE OBTAINED FROM SHOPIFY - see the "ACTION REQUIRED FROM MANPREET" section of
# docs/architecture/shopify-dev-store-certification-preparation.md. None are fabricated or guessed.
#
# AUTH HARDENING: there is NO access-token env var here. Legacy admin-created custom apps used to show a
# static shpat_... token in the Shopify admin - that mechanism was deprecated 2026-01-01. A current Dev
# Dashboard app authenticates via the client-credentials grant: ShopifyLiveConnector itself exchanges
# Client ID + Client Secret for a short-lived (~24h) access token on demand (connectors/shopify_live/auth.py)
# and refreshes it automatically - no token is ever stored, logged, or handed to Sanocea directly.
#
# SANOCEA_SHOPIFY_LIVE_SHOP_DOMAIN=your-dev-store.myshopify.com   # the development store's *.myshopify.com domain
# SANOCEA_SHOPIFY_LIVE_CLIENT_ID=                                 # the app's Client ID, from the Dev Dashboard (Settings)
# SANOCEA_SHOPIFY_LIVE_CLIENT_SECRET=                             # the app's Client secret, from the same page - used for BOTH the client-credentials grant and webhook HMAC verification
# SANOCEA_SHOPIFY_LIVE_API_VERSION=2026-07                        # current stable Admin API version as of this writing - bump forward as versions advance
# SANOCEA_SHOPIFY_LIVE_WEBHOOK_DELIVERY_BASE_URL=                 # the public HTTPS URL Shopify's cloud can reach THIS Sanocea instance at during certification (a tunnel URL - see the prep doc's webhook-ingress section)
#
# No default-location env var: the store's primary inventory location is discovered programmatically by
# ShopifyLiveConnector itself (a GraphQL query, cached on first use) - never manually configured.

